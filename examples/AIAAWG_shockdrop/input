# Parallelization
Partition : 3 2 1 

Shock generator: true

# setup for AIAAWG case 6 without surface tension (ICs verified)
# tc = 13.1 

# Mesh definition
Lx :	12
nx :	600 # 2400 # 200CPD
Ly :	8
ny :	400 # 1600
Lz : 	1
nz : 	1

# AIAAWG inputs (variable convention post shock = _2, pre shock = _1 = _amb) 
# we enforce d = 1, rho2 = 1, delta_u = u2 - u1 = 1 
M_inf : 1.6               # free stream post shock mach number (u_inf/c_inf)
Re    : 1000              # Reynolds number (due to assumptions = 1/mu_g) (set to zero for inviscid)
# We  : 0                 # Weber number    (due to assumptions = 1/sigma)

Density ratio     : 816   # rho_l/rho_amb
Viscosity ratio   : 58.3  # mu_l/mu_amb,g
Sound speed ratio : 4.3   # c_l/c_amb,g

Gas gamma     : 1.4
Liquid gamma  : 6.12
Drop location : 2     # center location of drop
Shock location: 0.997 # location of shock

# Time integration
Max timestep size : 7.76e-3 # 1.94e-3
Max cfl number    : 0.5
Max time          : 40      # ~ Tau = 3
Max steps         : 1000000

# Ensight output
Ensight output period :  0.2