# --- case flags ---
Shock generator:  true   # true for numerical shock initialization
Dimensional flag: true   # true for running a dimensional simulation

# Adimensional flow parameters
!---------- eos ----------
Gas gamma :         1.3
Liquid gamma :      6.12
!--- fluids definition ---
Density ratio :     854.7
Sound speed ratio : 4.32
!------- inviscid --------
Shock Mach number : 5.12
Shock location :   -0.6
!------- viscous ---------
Gas Reynolds number : 1.52e5
Viscosity ratio :     49.8 ! dynamic viscosity ratio set this to zero for nondimensional invisicd case 

# For running ellipsoid case, be careful of shock placement and domain size with an ellipsoid case!!! (comment out for spheroid)
Radii: 0.6321 0.5 0.6321 # diameters 1.2642 1.0 1.2642 AR = 1.2642 ==> average of front lit experiments aspect ratios

# dimensional flow parameters (for dimensional runs only)
# Liquid
Drop diameter:  1.0
Liquid density: 815
Liquid dynamic viscosity: 1.89e-4 ! set to zero and constant for inviscid case
Liquid Pinf: 3.43e8
Liquid specific heat (constant vol): 4130.2 
# Gas
Pre-shock density : 1.17
Pre-shock pressure: 1.01e5
Gas dynamic viscosity: 1.813e-5
Gas specific heat (constant vol): 968.86 ! cv = R_air/(gamm_g-1) from IC, R_air = 290.66 J/(kg*K)

# Maximum simulation time
Max time : 30

# Postprocessing output
Ensight output period : 0.1
Drop analysis period  : 0.1

# burst
# time window for burst output use experimental camera exposure time for dimensional run, use scaled exposure time for nondimensional run --> t_burst = (tc_sim/tc_exp)*t_exposure
Exposure time : 0.08144 # nondim scaled exposure time for physical 110ns
# tau events for burst output (tau value for burst)
Burst tau A : 0.25
Burst tau B : 0.5
Burst tau C : 1.0
Burst tau D : 1.5
Burst tau E : 2.0

# Shock-drop simulation
!- Parallelization ----
Shock-drop partition : 2 4 1

!- Mesh ---------------
Shock-drop dx :     0.01
Shock-drop max nx : 250
Shock-drop max ny : 250
Shock-drop max nz : 1
Shock-drop margin : 0.25

!- Time ---------------
Shock-drop dt :  2.5e-3
Shock-drop CFL : 1

!- Remeshing ----------
Remeshing period :  0.2

!- Intial Perturbations-
SphHarm Nmode : 1
SphHarm l : 1       ! Arbitrary - setting mag to 0
SphHarm m : 1       !
SphHarm amp : 0.0   ! No initial perturbation
SphHarm phase : 0.0 ! Arbitrary

# Far-field simulation
!- Parallelization ----
Farfield partition : 8 1 1

!- Mesh ---------------
Farfield dx : 0.03
Farfield nx : 250 250 1
Farfield X0 : -2
