# --- case flags ---
Shock generator : false  # true for numerical shock initialization
Dimensional flag: false  # true for running a dimensional simulation

# Adimensional flow parameters
!---------- eos ----------
Gas gamma :         1.3
Liquid gamma :      6.12
!--- fluids definition ---
Density ratio :     854.7
Sound speed ratio : 4.32
!------- inviscid --------
Shock Mach number : 5.12
Shock location :   -0.6
!------- viscous ---------
Gas Reynolds number : 1.52e5
Viscosity ratio :     49.8 ! dynamic viscosity ratio set this to zero for nondimensional invisicd case 

# dimensional flow parameters (for dimensional runs only)
# Liquid
Drop diameter: 1.0 
Liquid density: 1000
Liquid dynamic viscosity: 9.12e-4 ! set to zero for dimensional inviscid case
Liquid Pinf: 3.43e8
Liquid specific heat (constant vol): 4130.2 
# Gas
Pre-shock density : 1.17
Pre-shock pressure: 1.01e5
Gas dynamic viscosity: 18.31e-6
Gas specific heat (constant vol): 968.86 ! cv = R_air/(gamm_g-1) from IC, R_air = 290.66 J/(kg*K)

# Maximum simulation time
Max time : 30

# Postprocessing output
Ensight output period : 5e-4 #1.25e-3 #2.5e-3 #0.1
Drop analysis period  : 0.1

# Shock-drop simulation
!- Parallelization ----
Shock-drop partition : 2 4 1
!- Mesh ---------------
Shock-drop dx :     0.01
Shock-drop max nx : 250
Shock-drop max ny : 250
Shock-drop max nz : 1
Shock-drop margin : 0.25
!- Remeshing ----------
Remeshing period : 0.2
!- Intial Perturbations-
SphHarm Nmode : 1
SphHarm l : 1       ! Arbitrary - setting mag to 0
SphHarm m : 1       !
SphHarm amp : 0.0   ! No initial perturbation
SphHarm phase : 0.0 ! Arbitrary
!- Time ---------------
Shock-drop dt :  5e-4 #1.25e-3 #2.5e-3
Shock-drop CFL : 0.5 #1

# Far-field simulation
!- Parallelization ----
Farfield partition : 8 1 1
!- Mesh ---------------
Farfield dx : 0.03
Farfield nx : 250 250 1 !250
Farfield X0 : -2
