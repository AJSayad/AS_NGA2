# Adimensional flow parameters
!---------- eos ----------
Gas gamma :         1.3
Liquid gamma :      6.12
!--- fluids definition ---
Density ratio :     854.7
Sound speed ratio : 4.32
!------- inviscid --------
Shock Mach number : 5.12
Shock location :   -0.6
!------- viscous ---------
Gas Reynolds number : 1.52e5
Viscosity ratio :     49.8 ! dynamic viscosity ratio set this to zero for nondimensional invisicd case 

# Maximum simulation time
Max time : 30

# Postprocessing output
Ensight output period : 0.1
Drop analysis period  : 0.1
# time window for burst output 
# use experimental camera exposure time for dimensional run, use scaled exposure time for nondimensional run --> t_burst = (tc_sim/tc_exp)*t_exposure
Exposure time : 0.08144 # nondim scaled exposure time for physical 110ns
# tau events for burst output (tau value for burst)
Burst tau A : 0.25
Burst tau B : 1.0
Burst tau C : 1.5
Burst tau D : 2.0
Burst tau E : 2.5

# Shock-drop simulation
!- Parallelization ----
Shock-drop partition : 2 4 1

!- Mesh ---------------
Shock-drop dx :     0.01
Shock-drop max nx : 250
Shock-drop max ny : 250
Shock-drop max nz : 1
Shock-drop margin : 0.25

!- Remeshing ----------
Remeshing period : 0.2

!- Intial Perturbations-
SphHarm Nmode : 1
SphHarm l : 1       ! Arbitrary - setting mag to 0
SphHarm m : 1       !
SphHarm amp : 0.0   ! No initial perturbation
SphHarm phase : 0.0 ! Arbitrary

!- Time ---------------
Shock-drop dt :  2.5e-3
Shock-drop CFL : 0.5

# Far-field simulation
!- Parallelization ----
Farfield partition : 8 1 1

!- Mesh ---------------
Farfield dx : 0.03
Farfield nx : 250 250 1 !250
Farfield X0 : -2
