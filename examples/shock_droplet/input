# --- case flags ---
Shock generator : false  # true for numerical shock initialization
Dimensional flag: false  # true for running a dimensional simulation

# Adimensional flow parameters
!---------- eos ----------
Gas gamma :         1.3
Liquid gamma :      6.12
!--- fluids definition ---
Density ratio :     815
Sound speed ratio : 4.3
!------- inviscid --------
Shock Mach number : 5.12
Shock location :   -0.6
!------- viscous ---------
Gas Reynolds number : 1e5
Viscosity ratio :     0.0688 !58.3 ! kinematic viscosity (nuL/nuG) set this to zero for nondimensional invisicd case 

# dimensional flow parameters (for dimensional runs only)
# Liquid
Drop diameter: 1.0 
Liquid density: 815
Liquid kinematic viscosity: 5.83e-4 ! set to zero for dimensional inviscid case
Liquid Pinf: 1.34229E2
Liquid specific heat (constant vol): 3.21776E-02
# Gas
Pre-shock density : 1.0
Pre-shock pressure: 4.19464E-02
Gas kinematic viscosity: 1.00000E-05
Gas specific heat (constant vol): 1.39821E-01

# Maximum simulation time
Max time : 30

# Postprocessing output
Ensight output period : 5e-4 #1.25e-3 #2.5e-3 #0.1
Drop analysis period  : 0.1

# Shock-drop simulation
!- Parallelization ----
Shock-drop partition : 2 4 1
!- Mesh ---------------
Shock-drop dx :     0.01
Shock-drop max nx : 250
Shock-drop max ny : 250
Shock-drop max nz : 1
Shock-drop margin : 0.25
!- Remeshing ----------
Remeshing period : 0.2
!- Intial Perturbations-
SphHarm Nmode : 1
SphHarm l : 1       ! Arbitrary - setting mag to 0
SphHarm m : 1       !
SphHarm amp : 0.0   ! No initial perturbation
SphHarm phase : 0.0 ! Arbitrary
!- Time ---------------
Shock-drop dt :  5e-4 #1.25e-3 #2.5e-3
Shock-drop CFL : 0.5 #1

# Far-field simulation
!- Parallelization ----
Farfield partition : 8 1 1
!- Mesh ---------------
Farfield dx : 0.03
Farfield nx : 250 250 1 !250
Farfield X0 : -2
