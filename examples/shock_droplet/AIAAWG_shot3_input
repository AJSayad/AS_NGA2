# --- case flags ---
Shock generator : true   # true for numerical shock initialization
Dimensional flag: true   # true for running a dimensional simulation

# Adimensional flow parameters
!---------- eos ----------
Gas gamma :         1.3
Liquid gamma :      6.12
!--- fluids definition ---
Density ratio :     815
Sound speed ratio : 4.3
!------- inviscid --------
Shock Mach number : 5.298
Shock location :   -1e-3
!------- viscous ---------
Gas Reynolds number : 1e5
Viscosity ratio :     58.3 ! set this to zero for nondimensional invisicd case

# dimensional flow parameters (for dimensional runs only)
# Liquid
Drop diameter: 0.00187
Liquid density: 1000
Liquid dynamic viscosity: 1.89e-4 ! set to zero and constant for inviscid case
Liquid Pinf: 3.43e8
Liquid specific heat (constant vol): 4130.2 
# Gas
Pre-shock density : 1.17
Pre-shock pressure: 1.01e5
Gas dynamic viscosity: 1.813e-5
Gas specific heat (constant vol): 968.86 ! cv = R_air/(gamm_g-1) from IC, R_air = 290.66 J/(kg*K)

# Maximum simulation time
Max time : 5.147e-5 ! tau = 3.5

# Postprocessing output
Ensight output period : 1e-6
Drop analysis period  : 1e-6

# Shock-drop simulation
!- Parallelization ----
Shock-drop partition : 4 4 1 

!- Mesh ---------------
Shock-drop dx :     1.87e-5
Shock-drop max nx : 250
Shock-drop max ny : 250
Shock-drop max nz : 1
Shock-drop margin : 4.675e-4

!- Remeshing ----------
Remeshing period :  4.2e-7

!- Intial Perturbations-
SphHarm Nmode : 1
SphHarm l : 1       ! Arbitrary - setting mag to 0
SphHarm m : 1       !
SphHarm amp : 0.0   ! No initial perturbation
SphHarm phase : 0.0 ! Arbitrary

!- Time ---------------
Shock-drop dt :  4.2e-9
Shock-drop CFL : 0.5

# Far-field simulation
!- Parallelization ----
Farfield partition : 4 4 1

!- Mesh ---------------
Farfield dx : 5.61e-5
Farfield nx : 275 275 1
Farfield X0 : -3.74e-3
