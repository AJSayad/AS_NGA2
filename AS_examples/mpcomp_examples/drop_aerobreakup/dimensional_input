# --- case flags ---
Shock generator : true  # true for numerical shock initialization
Dimensional flag: true  # true for running a dimensional simulation

# Adimensional flow parameters
!---------- eos ----------
Gas gamma :         1.3
Liquid gamma :      6.12
!--- fluids definition ---
Density ratio :     815
Sound speed ratio : 4.3
!------- inviscid --------
Shock Mach number : 5.12
Shock location :    -0.001 !-0.6
!------- viscous ---------
Gas Reynolds number : 1e5
Viscosity ratio :     58.3 ! set this to zero for nondimensional invisicd case

# dimensional flow parameters (for dimensional runs only)
# Liquid
Drop diameter:  0.00187 !1.0 
Liquid density: 1000
Liquid dynamic viscosity: 5.8e-4 ! set to zero for dimensional inviscid case
Liquid Pinf: 3.43e8
Liquid specific heat (constant vol): 4130.2 
# Gas
Pre-shock density : 1.17
Pre-shock pressure: 1e5
Gas dynamic viscosity: 1e-5 ! set to zero for dimensional inviscid case
Gas specific heat (constant vol): 968.86 ! cv = R_air/(gamm_g-1) from IC, R_air = 290.66 J/(kg*K)

# Maximum simulation time
Max time : 1e-3 #30

# Postprocessing output
Ensight output period : 1e-6 !0.1
Drop analysis period :  1e-6 !0.1

# Shock-drop simulation
!- Parallelization ----
Shock-drop partition : 2 4 2 !2 4 1
!- Mesh ---------------
Shock-drop dx :     1.87e-5 !0.01
Shock-drop max nx : 500
Shock-drop max ny : 500
Shock-drop max nz : 500 
Shock-drop margin : 4.67e-4 !0.25
!- Remeshing ----------
Remeshing period : 0.2
!- Intial Perturbations-
SphHarm Nmode : 1
SphHarm l : 1       ! setting mag to 0
SphHarm m : 1       !
SphHarm amp : 0.0   ! no perturbation
SphHarm phase : 0.0 ! 
!- Time ---------------
Shock-drop dt  : 4.5e-9
Shock-drop CFL : 0.5 

# Far-field simulation
!- Parallelization ----
Farfield partition : 2 4 2 #8 1 1
!- Mesh ---------------
Farfield dx : 5.61e-5   !0.03
Farfield nx : 250 250 250
Farfield X0 : -0.00374  !-2
